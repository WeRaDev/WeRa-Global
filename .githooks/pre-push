#!/usr/bin/env bash

set -u

branch="$(git rev-parse --abbrev-ref HEAD)"

if [[ "${branch}" == "main" && "${ALLOW_MAIN_PUSH:-0}" != "1" ]]; then
  cat <<'MSG' >&2
ERROR: Direct push to 'main' is blocked by repository policy.
Use feature branch + Gitea PR workflow.
If this is an emergency maintenance push, rerun with:
  ALLOW_MAIN_PUSH=1 git push
MSG
  exit 1
fi

exit 0
