{
  "config_name": "polymarket_clob_live_integration",
  "config_version": "1.0.0",
  "updated_at": "2026-04-27T10:40:00Z",
  "source_docs": [
    "https://docs.polymarket.com/developers/CLOB/introduction",
    "https://docs.polymarket.com/developers/CLOB/authentication",
    "https://docs.polymarket.com/developers/CLOB/orders/orders",
    "https://docs.polymarket.com/developers/CLOB/websocket/wss-overview",
    "https://docs.polymarket.com/quickstart/orders/first-order",
    "https://docs.polymarket.com/changelog/changelog"
  ],
  "network": {
    "chain": "polygon",
    "chain_id": 137,
    "collateral_token": "pUSD",
    "gas_token": "POL"
  },
  "endpoints": {
    "clob_rest_base_url": "https://clob.polymarket.com",
    "clob_v2_pre_cutover_base_url": "https://clob-v2.polymarket.com",
    "gamma_api_base_url": "https://gamma-api.polymarket.com",
    "data_api_base_url": "https://data-api.polymarket.com",
    "relayer_base_url": "https://relayer-v2.polymarket.com",
    "websocket": {
      "market_channel": "wss://ws-subscriptions-clob.polymarket.com/ws/market",
      "user_channel": "wss://ws-subscriptions-clob.polymarket.com/ws/user",
      "sports_channel": "wss://sports-api.polymarket.com/ws",
      "rtds_channel": "wss://ws-live-data.polymarket.com"
    }
  },
  "authentication": {
    "model": "L1_L2",
    "l1_headers": [
      "POLY_ADDRESS",
      "POLY_SIGNATURE",
      "POLY_TIMESTAMP",
      "POLY_NONCE"
    ],
    "l2_headers": [
      "POLY_ADDRESS",
      "POLY_SIGNATURE",
      "POLY_TIMESTAMP",
      "POLY_API_KEY",
      "POLY_PASSPHRASE"
    ],
    "credentials_endpoints": {
      "create_api_key": "POST /auth/api-key",
      "derive_api_key": "GET /auth/derive-api-key"
    },
    "l2_signature_algorithm": "HMAC-SHA256",
    "order_payload_signing": "EIP-712",
    "server_side_only_signing": true
  },
  "wallet_signature_types": [
    {
      "name": "EOA",
      "id": 0,
      "requires_funder_address": true,
      "notes": "EOA wallet, pays gas directly."
    },
    {
      "name": "POLY_PROXY",
      "id": 1,
      "requires_funder_address": true,
      "notes": "Proxy wallet used by some Polymarket login flows."
    },
    {
      "name": "GNOSIS_SAFE",
      "id": 2,
      "requires_funder_address": true,
      "notes": "Most common proxy-safe route for Polymarket accounts."
    }
  ],
  "order_rules": {
    "supported_order_types": [
      "GTC",
      "GTD",
      "FOK",
      "FAK"
    ],
    "market_order_types": [
      "FOK",
      "FAK"
    ],
    "post_only_allowed_for": [
      "GTC",
      "GTD"
    ],
    "required_market_metadata": [
      "tick_size",
      "neg_risk"
    ],
    "user_channel_heartbeat": {
      "ping_interval_seconds": 10,
      "pong_expected": "PONG"
    }
  },
  "rate_limits": {
    "clob_authentication": "100 requests / 10s",
    "clob_trading": {
      "post_order": {
        "burst": "3500 requests / 10s",
        "sustained": "36000 requests / 10min"
      },
      "delete_order": {
        "burst": "3000 requests / 10s",
        "sustained": "30000 requests / 10min"
      },
      "post_orders_batch": {
        "burst": "1000 requests / 10s",
        "sustained": "15000 requests / 10min"
      },
      "delete_orders_batch": {
        "burst": "1000 requests / 10s",
        "sustained": "15000 requests / 10min"
      },
      "cancel_all": {
        "burst": "250 requests / 10s",
        "sustained": "6000 requests / 10min"
      }
    },
    "data_api_general": "1000 requests / 10s"
  },
  "environment_notes": {
    "primary_trading_environment": "Production CLOB on Polygon mainnet.",
    "pre_cutover_validation_environment": "CLOB V2 pre-cutover endpoint available when announced in changelog.",
    "sandbox_testnet_note": "Use internal paper-trading/canary controls if a public sandbox is unavailable for the required flow."
  }
}
