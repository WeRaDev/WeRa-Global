{
  "config_name": "poly_robot_live_rollout_rehearsal_protocol",
  "config_version": "1.1.0",
  "updated_at": "2026-04-27T14:51:00Z",
  "description": "Phase-D3 rehearsal protocol for deterministic control drills and explicit rollback decisions before live rollout expansion.",
  "precheck_commands": [
    "python3 scripts/run_runtime_supervisor.py --help",
    "python3 scripts/run_runtime_gui.py --help",
    "PYTHONPATH=src python3 -m unittest tests.test_runtime_supervisor_controls tests.test_runtime_web_gui"
  ],
  "postcheck_commands": [
    "PYTHONPATH=src python3 -m unittest tests.test_runtime_supervisor_controls",
    "PYTHONPATH=src python3 -m unittest tests.test_runtime_supervisor_live",
    "PYTHONPATH=src python3 -m unittest tests.test_integration_adapters"
  ],
  "drill_scenarios": [
    {
      "id": "baseline_control_path",
      "description": "Control state clear; cycle should execute normally.",
      "control_state_overrides": {
        "paused": false,
        "restart_requested": false,
        "kill_switch_active": false,
        "cancel_all_requested": false
      },
      "expected": {
        "cycle_status": "EXECUTED",
        "kill_switch_active": false,
        "cancel_all_requested": false,
        "cancel_all_acknowledged": false
      }
    },
    {
      "id": "kill_switch_gate",
      "description": "Kill switch active; cycle emits control gate heartbeat and prevents open-order carryover.",
      "control_state_overrides": {
        "paused": false,
        "restart_requested": false,
        "kill_switch_active": true,
        "cancel_all_requested": false
      },
      "expected": {
        "cycle_status": "EXECUTED",
        "kill_switch_active": true,
        "heartbeat_stage": "control_kill_switch_gate"
      }
    },
    {
      "id": "cancel_all_gate",
      "description": "Cancel-all request should be acknowledged and cleared in persisted control state.",
      "control_state_overrides": {
        "paused": false,
        "restart_requested": false,
        "kill_switch_active": false,
        "cancel_all_requested": true
      },
      "expected": {
        "cycle_status": "EXECUTED",
        "cancel_all_requested": true,
        "cancel_all_acknowledged": true,
        "heartbeat_stage": "control_cancel_all_applied"
      }
    },
    {
      "id": "restart_acknowledgement_gate",
      "description": "Restart request should produce RESTART_REQUESTED status and clear restart flag after acknowledgement.",
      "control_state_overrides": {
        "paused": false,
        "restart_requested": true,
        "kill_switch_active": false,
        "cancel_all_requested": false
      },
      "expected": {
        "cycle_status": "RESTART_REQUESTED",
        "heartbeat_stage": "control_restart_acknowledged",
        "restart_acknowledged": true
      }
    }
  ],
  "rollback_decision_matrix": [
    {
      "trigger": "live_credential_preflight_failed",
      "condition": "runtime startup exits non-zero with Live credential preflight failed",
      "severity": "blocker",
      "required_actions": [
        "disable_new_orders",
        "rotate_api_credentials",
        "rerun credential preflight before resume"
      ]
    },
    {
      "trigger": "kill_switch_gate_missing",
      "condition": "kill_switch_active drill does not emit control_kill_switch_gate heartbeat",
      "severity": "critical",
      "required_actions": [
        "switch_to_paper_mode",
        "cancel_all_open_orders",
        "require_manual_operator_ack_for_resume"
      ]
    },
    {
      "trigger": "cancel_all_not_acknowledged",
      "condition": "cancel_all_requested drill does not clear control flag and emit acknowledgement",
      "severity": "critical",
      "required_actions": [
        "disable_new_orders",
        "cancel_all_open_orders",
        "run rollback rehearsal immediately"
      ]
    },
    {
      "trigger": "restart_recovery_not_acknowledged",
      "condition": "restart_requested drill does not produce RESTART_REQUESTED metadata or leaves restart flag set",
      "severity": "high",
      "required_actions": [
        "switch_to_paper_mode",
        "require_manual_operator_ack_for_resume",
        "block rollout progression until drill passes"
      ]
    },
    {
      "trigger": "command_bundle_failed",
      "condition": "any precheck_commands or postcheck_commands entry exits non-zero or fails command parsing",
      "severity": "blocker",
      "required_actions": [
        "stop_rollout_progression",
        "inspect_failed_bundle_command_output",
        "fix_environment_or_regression_and_rerun_rehearsal"
      ]
    }
  ]
}
