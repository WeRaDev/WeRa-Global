  "scope": "MVP test-token operation and stress-test preparation",
  "source_report": "/Users/mikhailananyin/Documents/WeRa materials/PolyRobot.md",
  "principles": [
    "Replay-first development contract for all modules",
    "Risk engine before execution adapter",
    "LLM advisory-only mode until calibration and reliability thresholds are proven"
  ],
  "functional_requirements": [
    {
      "id": "FR-001",
      "name": "Target wallet mining",
      "definition": "System shall derive target-wallet set from historical trade data using explicit filters and ranking."
    },
    {
      "id": "FR-002",
      "name": "Market scanning and filtration",
      "definition": "System shall scan active markets and retain only candidates that satisfy edge, depth, liquidity, and time-window constraints."
    },
    {
      "id": "FR-003",
      "name": "Decisioning checks",
      "definition": "System shall require multi-check agreement and confidence threshold before producing BUY candidates."
    },
    {
      "id": "FR-004",
      "name": "Replay contract",
      "definition": "All strategy/risk modules shall run through deterministic replay harness using shared data contracts."
    },
    {
      "id": "FR-005",
      "name": "Risk-first order approval",
      "definition": "Risk engine shall approve or deny candidate trades before any execution adapter is introduced."
    },
    {
      "id": "FR-006",
      "name": "Advisory-only LLM policy",
      "definition": "LLM outputs shall remain advisory unless reliability thresholds are met and calibration is explicitly proven."
    }
  ],
