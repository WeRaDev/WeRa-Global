  "formulas": [
    {
      "id": "F-001",
      "name": "Price gap",
      "expression": "gap = abs(estimated_probability - midpoint)"
    },
    {
      "id": "F-002",
      "name": "Scanner EV proxy",
      "expression": "ev_proxy = gap * min_side_depth_usd * scanner.ev_scale_factor"
    },
    {
      "id": "F-003",
      "name": "Kelly fraction",
      "expression": "f* = (p * b - q) / b where b = (1 / price) - 1 and q = 1 - p"
    }
  ]
