<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_content_matrix" model="ir.module.category">
        <field name="name">Content Matrix</field>
        <field name="sequence">40</field>
    </record>

    <record id="res_groups_privilege_content_matrix" model="res.groups.privilege">
        <field name="name">Content Matrix</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="module_category_content_matrix"/>
    </record>

    <record id="group_operator" model="res.groups">
        <field name="name">Operator</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_content_matrix"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

<record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_content_matrix"/>
        <field name="implied_ids" eval="[(4, ref('group_operator'))]"/>
        <!-- base.user_admin only; other internal users get rights via Settings or post-login grant -->
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

<!-- Settings administrators inherit Content Matrix Manager -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_manager'))]"/>
    </record>
</odoo>
